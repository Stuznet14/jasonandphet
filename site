<title>Clara & Julian</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Corinthia:wght@400;700&family=Italianno&family=Jost:wght@300;400;500&display=swap">
<style>
:root{
  --linen:#F7F3EC; --linen-2:#F0EAE0; --paper:#FCFAF6;
  --ink:#23342E; --ink-2:rgba(35,52,46,.74); --ink-3:rgba(35,52,46,.54);
  --olive:#6E7B4F; --olive-2:#8A9668; --olive-soft:rgba(110,123,79,.14);
  --line:rgba(35,52,46,.16); --line-2:rgba(35,52,46,.09);
  --lemon:#E9C46A; --lemon-2:#F3D98B;
  --clay:#C9744F; --clay-2:#B5623F;
  --table:#1E2622;
  --script:"Corinthia","Italianno","Brush Script MT",cursive;
  --serif:"Cormorant Garamond","Times New Roman",Georgia,serif;
  --sans:"Jost","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--table);color:var(--ink);font-family:var(--serif);font-size:18px;line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100vh}
body.locked{overflow:hidden}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
a{color:inherit}
:focus-visible{outline:2px solid var(--olive);outline-offset:3px;border-radius:4px}
svg{display:block}
[hidden]{display:none!important}

/* ---------- Frame: the invitation is a phone-width column ---------- */
.invite{position:relative;width:100%;max-width:430px;margin:0 auto;background:var(--linen);overflow:hidden}
@media (min-width:520px){
  body{background:radial-gradient(ellipse at 50% 0%,#2B3630,var(--table) 70%)}
  .invite{margin:28px auto;border-radius:30px;box-shadow:0 40px 90px -30px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.05)}
}

/* ---------- Type roles ---------- */
.eyebrow{font-family:var(--sans);font-weight:400;font-size:10.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--olive);margin:0}
.title{font-family:var(--script);font-weight:700;font-size:58px;line-height:.95;color:var(--ink);margin:0;text-wrap:balance}
.lede{font-size:19px;line-height:1.55;color:var(--ink-2);margin:0;max-width:34ch;margin-inline:auto}
.small{font-family:var(--sans);font-size:12px;letter-spacing:.06em;color:var(--ink-3);font-weight:300}
.caps{font-family:var(--sans);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-2);font-weight:400}

/* ---------- Sections ---------- */
.sec{padding:64px 28px;text-align:center;position:relative}
.sec--tint{background:var(--linen-2)}
.sec-head{display:grid;gap:14px;justify-items:center;margin-bottom:28px}
.divider{display:flex;justify-content:center;padding:34px 0 0;color:var(--olive)}
.divider svg{width:220px;height:auto}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:46px;padding:0 26px;border-radius:999px;border:1px solid var(--ink);font-family:var(--sans);font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:400;text-decoration:none;color:var(--ink);background:transparent;transition:background .2s,color .2s,transform .2s,border-color .2s}
.btn:hover{background:var(--ink);color:var(--linen)}
.btn:active{transform:translateY(1px)}
.btn--primary{background:var(--clay);border-color:var(--clay);color:#FFF7EE}
.btn--primary:hover{background:var(--clay-2);border-color:var(--clay-2);color:#FFF7EE}
.btn--ghost{border-color:var(--line);color:var(--ink-2)}
.btn--ghost:hover{border-color:var(--ink);background:transparent;color:var(--ink)}
.btn-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.btn svg{width:14px;height:14px}

/* ---------- Music toggle ---------- */
.music{position:fixed;top:14px;right:14px;z-index:40;display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 12px 0 10px;border-radius:999px;background:rgba(252,250,246,.82);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--line);font-family:var(--sans);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-2);box-shadow:0 6px 18px -10px rgba(0,0,0,.35)}
.music .bars{display:inline-flex;align-items:flex-end;gap:2px;height:12px}
.music .bars i{display:block;width:2px;height:4px;background:var(--olive);border-radius:1px;transition:height .2s}
.music.on .bars i{animation:eq 1s ease-in-out infinite}
.music.on .bars i:nth-child(2){animation-delay:.15s}.music.on .bars i:nth-child(3){animation-delay:.3s}
@keyframes eq{0%,100%{height:4px}50%{height:12px}}
@media (min-width:520px){.music{right:calc(50% - 215px + 14px);top:42px}}

/* ---------- Envelope intro ---------- */
.intro{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:var(--table);transition:opacity .7s ease}
.intro.fade{opacity:0;pointer-events:none}
.intro-col{width:100%;max-width:430px;height:100%;background:
  radial-gradient(circle at 25% 20%,rgba(255,255,255,.55) 0 2px,transparent 3px) 0 0/28px 28px,
  radial-gradient(circle at 75% 70%,rgba(35,52,46,.05) 0 2px,transparent 3px) 0 0/34px 34px,
  linear-gradient(180deg,#EFE9DD,#E7E0D2);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;position:relative}
@media (min-width:520px){.intro-col{height:calc(100% - 56px);border-radius:30px}}
.envelope{position:relative;width:min(78vw,300px);aspect-ratio:3/4;perspective:1200px;display:block}
.env{position:absolute;inset:0;transform-style:preserve-3d}
.env-back{position:absolute;inset:0;background:#F3EDE1;border-radius:10px;box-shadow:0 30px 60px -28px rgba(0,0,0,.55),0 2px 0 rgba(255,255,255,.6) inset}
.env-card{position:absolute;left:7%;right:7%;top:9%;bottom:6%;background:var(--paper);border-radius:6px;box-shadow:0 10px 30px -18px rgba(0,0,0,.4);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:1;transform:translateY(0);transition:transform 1s cubic-bezier(.2,.7,.2,1) .55s,z-index 0s .9s}
.env-card .mono{font-family:var(--script);font-weight:700;font-size:64px;line-height:1;color:var(--ink)}
.env-card .sub{font-family:var(--sans);font-size:10px;letter-spacing:.28em;text-transform:uppercase;color:var(--olive)}
.env-pocket{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,#F6F1E6,#EEE7DA);clip-path:polygon(0 0,50% 46%,100% 0,100% 100%,0 100%);border-radius:10px;box-shadow:0 -1px 0 rgba(0,0,0,.05) inset}
.env-pocket::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 30% 60%,rgba(35,52,46,.045) 0 5px,transparent 6px) 0 0/36px 36px,radial-gradient(circle at 70% 30%,rgba(35,52,46,.04) 0 4px,transparent 5px) 18px 18px/36px 36px;clip-path:inherit}
.env-flap{position:absolute;left:0;right:0;top:0;height:48%;z-index:3;background:linear-gradient(180deg,#F2ECDF,#E9E2D3);clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top center;transform:rotateX(0deg);transition:transform .9s cubic-bezier(.6,.05,.3,1),z-index 0s .45s;backface-visibility:hidden}
.env-flap::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 35%,rgba(35,52,46,.05) 0 6px,transparent 7px) 0 0/40px 40px;clip-path:inherit}
.seal{position:absolute;left:50%;top:46%;width:96px;height:96px;transform:translate(-50%,-50%);z-index:4;border-radius:48% 52% 50% 50%/50% 48% 52% 50%;background:radial-gradient(circle at 35% 30%,#DC8C66,#C9744F 55%,#A9573A);box-shadow:0 10px 20px -10px rgba(0,0,0,.55),0 1px 0 rgba(255,255,255,.35) inset,0 -3px 8px rgba(0,0,0,.18) inset;display:flex;align-items:center;justify-content:center;transition:transform .5s ease,opacity .5s ease}
.seal::before{content:"";position:absolute;inset:11px;border-radius:50%;border:1px solid rgba(255,240,225,.55);box-shadow:0 1px 0 rgba(0,0,0,.15)}
.seal span{font-family:var(--script);font-weight:700;font-size:38px;line-height:1;color:#FBEDE2;text-shadow:0 -1px 0 rgba(0,0,0,.25),0 1px 0 rgba(255,255,255,.2)}
.seal span i{font-style:normal;font-size:24px;margin:0 2px;opacity:.9}
.tap{font-family:var(--sans);font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-2);animation:breathe 2.6s ease-in-out infinite;transition:opacity .4s}
@keyframes breathe{0%,100%{opacity:.55}50%{opacity:1}}
.env.open .seal{transform:translate(-50%,-50%) scale(1.25);opacity:0}
.env.open .env-flap{transform:rotateX(180deg);z-index:0}
.env.open .env-card{transform:translateY(-58%) scale(1.03);z-index:3}

/* ---------- Hero ---------- */
.hero{position:relative;aspect-ratio:39/56;min-height:560px;display:grid;place-items:center;background:radial-gradient(ellipse at 50% 28%,#FCFAF4 0%,#F4F1E7 55%,#E9EBDD 100%);overflow:hidden}
.hero svg{position:absolute;inset:0;width:100%;height:100%}
.hero-copy{position:relative;z-index:2;display:grid;gap:14px;justify-items:center;padding:0 40px;text-align:center}
.hero-copy .eyebrow{font-size:10px}
.names{font-family:var(--script);font-weight:700;font-size:clamp(64px,19vw,84px);line-height:.92;margin:0;color:var(--ink);display:grid;gap:0}
.names .amp{font-size:.55em;color:var(--clay);line-height:1;transform:translateY(-.05em)}
.date-block{display:grid;grid-auto-flow:column;align-items:center;gap:14px;font-family:var(--sans);font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-2);margin-top:6px}
.date-block b{font-family:var(--serif);font-weight:400;font-size:34px;letter-spacing:0;color:var(--ink);line-height:1}
.date-block .dot{width:3px;height:3px;border-radius:50%;background:var(--clay)}
.place{font-style:italic;font-size:18px;color:var(--ink-2);margin:0}
.discover{position:absolute;bottom:26px;left:0;right:0;z-index:2;display:grid;justify-items:center;gap:6px;font-family:var(--sans);font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-2);text-decoration:none}
.discover svg{width:14px;height:14px;animation:nudge 1.8s ease-in-out infinite}
@keyframes nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}

/* ---------- Countdown ---------- */
.oval{position:relative;margin:8px auto 0;width:300px;max-width:100%;padding:38px 22px 34px;border:1px solid var(--olive);border-radius:50%/48%;display:grid;gap:8px;justify-items:center}
.oval::before{content:"";position:absolute;inset:6px;border:1px solid var(--line-2);border-radius:inherit}
.oval .lemon{position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:34px;height:34px;background:var(--linen)}
.count{display:grid;grid-auto-flow:column;gap:20px;align-items:start}
.count div{display:grid;justify-items:center;gap:4px}
.count b{font-family:var(--serif);font-weight:300;font-size:48px;line-height:1;color:var(--ink);font-variant-numeric:tabular-nums;min-width:2ch}
.count span{font-family:var(--sans);font-size:9px;letter-spacing:.24em;text-transform:uppercase;color:var(--ink-3)}
.count .sep{font-family:var(--serif);font-size:34px;font-weight:300;color:var(--olive-2);line-height:1;padding-top:4px}

/* ---------- Scratch card ---------- */
.reveal-wrap{position:relative;width:300px;max-width:100%;margin:10px auto 0;aspect-ratio:3/4}
.reveal-card{position:absolute;inset:0;border-radius:150px 150px 18px 18px;background:linear-gradient(180deg,#F9F0D9 0%,#F2DFB8 45%,#E4C58F 100%);box-shadow:0 30px 50px -30px rgba(35,52,46,.45);overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:0 24px 30px;text-align:center}
.reveal-card .scene{position:absolute;inset:0}
.reveal-card .scene svg{width:100%;height:100%}
.reveal-card .cap{position:relative;display:grid;gap:6px;justify-items:center}
.reveal-card .cap .said{font-family:var(--script);font-weight:700;font-size:54px;line-height:1;color:var(--ink)}
.reveal-card .cap .where{font-family:var(--sans);font-size:10px;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-2)}
.scratch{position:absolute;inset:0;width:100%;height:100%;border-radius:150px 150px 18px 18px;touch-action:none;cursor:crosshair;transition:opacity .8s ease}
.scratch.done{opacity:0;pointer-events:none}
.reveal-hint{margin-top:16px}

/* ---------- Formal invitation ---------- */
.formal{display:grid;gap:14px;justify-items:center}
.formal .who{font-family:var(--script);font-weight:700;font-size:60px;line-height:1;color:var(--ink)}
.formal .and{font-style:italic;color:var(--clay);font-size:22px}
.formal .full{font-size:16px;letter-spacing:.02em;color:var(--ink-3);font-style:italic;margin:-6px 0 0}
.formal .when{font-size:21px;line-height:1.4;color:var(--ink-2);font-style:italic;margin:0}

/* ---------- Venue ---------- */
.venue-art{width:100%;max-width:320px;margin:0 auto 10px}
.venue{display:grid;gap:10px;justify-items:center}
.venue .name{font-family:var(--serif);font-weight:400;font-size:38px;line-height:1.05;margin:0;color:var(--ink);text-wrap:balance}
.venue .addr{font-size:17px;line-height:1.5;color:var(--ink-2);margin:0}
.venue .time{display:grid;grid-auto-flow:column;gap:12px;align-items:center;font-size:19px;color:var(--ink);font-style:italic}
.venue .time .dot{width:3px;height:3px;border-radius:50%;background:var(--clay)}
.venue .btn-row{margin-top:8px}

/* ---------- Dress code ---------- */
.dress{display:grid;gap:22px;justify-items:center}
.dress .code{font-family:var(--serif);font-size:40px;font-weight:300;letter-spacing:.02em;margin:0;color:var(--ink)}
.swatches{display:flex;gap:18px;justify-content:center;flex-wrap:wrap}
.swatches div{display:grid;gap:8px;justify-items:center}
.swatches i{display:block;width:44px;height:44px;border-radius:50%;box-shadow:0 0 0 1px rgba(35,52,46,.12) inset,0 8px 14px -10px rgba(0,0,0,.35)}
.swatches span{font-family:var(--sans);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-3)}

/* ---------- Schedule ---------- */
.timeline{list-style:none;margin:8px 0 0;padding:0;display:grid;text-align:left;max-width:320px;margin-inline:auto}
.timeline li{display:grid;grid-template-columns:64px 18px 1fr;align-items:baseline;column-gap:12px;position:relative;padding:11px 0}
.timeline li::before{content:"";position:absolute;left:84px;top:0;bottom:0;width:1px;background:var(--line)}
.timeline li:first-child::before{top:50%}.timeline li:last-child::before{bottom:50%}
.timeline time{font-family:var(--sans);font-size:12px;letter-spacing:.14em;color:var(--olive);font-variant-numeric:tabular-nums;text-align:right}
.timeline .node{width:7px;height:7px;border-radius:50%;background:var(--linen);border:1px solid var(--olive);justify-self:center;position:relative;z-index:1;transform:translateY(-1px)}
.timeline li.key .node{background:var(--clay);border-color:var(--clay)}
.timeline .what{font-size:19px;color:var(--ink);line-height:1.3}
.timeline .what em{display:block;font-size:14px;color:var(--ink-3);font-style:italic}

/* ---------- Story ---------- */
.story{display:grid;gap:12px;margin-top:6px}
.chapter{background:var(--paper);border:1px solid var(--line-2);border-radius:18px;padding:22px 22px 20px;text-align:left;display:grid;grid-template-columns:auto 1fr;gap:6px 18px;align-items:start}
.chapter .year{grid-row:span 2;font-family:var(--serif);font-weight:300;font-size:34px;line-height:1;color:var(--clay);font-variant-numeric:tabular-nums;padding-top:2px}
.chapter h3{margin:0;font-family:var(--serif);font-weight:500;font-size:20px;color:var(--ink)}
.chapter p{margin:0;font-size:16px;line-height:1.5;color:var(--ink-2)}

/* ---------- Weekend / events ---------- */
.events{display:grid;gap:14px;margin-top:6px}
.event{border-top:1px solid var(--line);padding-top:22px;display:grid;gap:8px;justify-items:center}
.event .eyebrow{color:var(--clay)}
.event h3{margin:0;font-family:var(--serif);font-weight:400;font-size:30px;line-height:1.1;color:var(--ink)}
.event p{margin:0;font-size:17px;color:var(--ink-2)}
.event .btn-row{margin-top:6px}

/* ---------- Travel ---------- */
.stay{display:grid;gap:12px;margin-top:22px}
.hotel{background:var(--paper);border:1px solid var(--line-2);border-radius:18px;padding:22px;text-align:left;display:grid;gap:8px}
.hotel .eyebrow{font-size:9.5px}
.hotel h3{margin:0;font-family:var(--serif);font-weight:500;font-size:22px;color:var(--ink)}
.hotel p{margin:0;font-size:16px;color:var(--ink-2);line-height:1.45}
.hotel dl{margin:4px 0 0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:15px}
.hotel dt{font-family:var(--sans);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-3);padding-top:3px}
.hotel dd{margin:0;color:var(--ink)}
.hotel .btn-row{justify-content:flex-start;margin-top:6px}
.hotel .btn{min-height:38px;padding:0 18px;font-size:10px}

/* ---------- Gifts ---------- */
.gift details{margin-top:18px}
.gift summary{list-style:none;display:inline-flex;cursor:pointer}
.gift summary::-webkit-details-marker{display:none}
.gift .gift-box{margin-top:16px;background:var(--paper);border:1px solid var(--line-2);border-radius:14px;padding:18px;font-size:16px;color:var(--ink-2);line-height:1.5}

/* ---------- RSVP ---------- */
.rsvp form{display:grid;gap:26px;text-align:left;margin-top:8px}
.field{display:grid;gap:8px}
.field > label,.field > .lbl{font-family:var(--sans);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--olive)}
.input{width:100%;background:transparent;border:0;border-bottom:1px solid var(--line);border-radius:0;padding:8px 0 10px;font-family:var(--serif);font-size:20px;color:var(--ink);outline:none;transition:border-color .2s}
.input:focus{border-color:var(--ink)}
.input::placeholder{color:var(--ink-3);font-style:italic}
textarea.input{resize:vertical;min-height:72px;line-height:1.4}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.choice{position:relative}
.choice input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.choice span{display:flex;align-items:center;justify-content:center;min-height:48px;padding:0 12px;border:1px solid var(--line);border-radius:999px;font-family:var(--sans);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);text-align:center;transition:all .2s}
.choice input:checked + span{background:var(--ink);border-color:var(--ink);color:var(--linen)}
.choice input:focus-visible + span{outline:2px solid var(--olive);outline-offset:3px}
.stepper{display:inline-grid;grid-auto-flow:column;align-items:center;gap:22px;border:1px solid var(--line);border-radius:999px;padding:4px 6px;justify-self:start}
.stepper button{width:38px;height:38px;border-radius:50%;font-family:var(--serif);font-size:24px;line-height:1;color:var(--ink-2);display:grid;place-items:center;transition:background .2s}
.stepper button:hover{background:var(--olive-soft)}
.stepper b{font-family:var(--serif);font-weight:400;font-size:24px;min-width:1.5ch;text-align:center;font-variant-numeric:tabular-nums}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{position:relative}
.chip input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.chip span{display:inline-flex;align-items:center;min-height:34px;padding:0 14px;border:1px solid var(--line);border-radius:999px;font-family:var(--sans);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2);transition:all .2s}
.chip input:checked + span{background:var(--olive);border-color:var(--olive);color:var(--linen)}
.chip input:focus-visible + span{outline:2px solid var(--olive);outline-offset:3px}
.err{font-family:var(--sans);font-size:12px;color:var(--clay-2);margin:0;letter-spacing:.02em}
.rsvp .submit{justify-self:stretch;min-height:52px}
.rsvp-done{display:grid;gap:14px;justify-items:center;text-align:center;background:var(--paper);border:1px solid var(--line-2);border-radius:20px;padding:28px 22px}
.rsvp-done .said{font-family:var(--script);font-weight:700;font-size:54px;line-height:1;color:var(--ink)}
.rsvp-done pre{white-space:pre-wrap;text-align:left;width:100%;margin:0;font-family:var(--serif);font-size:16px;line-height:1.5;color:var(--ink-2);background:var(--linen-2);border-radius:12px;padding:14px 16px}
.rsvp-done .note{font-size:15px;color:var(--ink-3);margin:0;font-style:italic}
.link{background:none;border:0;padding:0;font:inherit;font-size:15px;color:var(--olive);text-decoration:underline;text-underline-offset:3px;cursor:pointer}

/* ---------- Footer ---------- */
