    var steps = 64;
    for (i = 0; i <= steps; i++){
      var a = Math.PI - (Math.PI * i / steps);
      var px = cx + rx * Math.cos(a), py = cy - ry * Math.sin(a);
      var dx = -rx * Math.sin(a), dy = -ry * Math.cos(a);
      pts.push({ x: px, y: py, t: Math.atan2(dy, dx) * 180 / Math.PI });
    }
    for (y = cy + 11; y <= legBottom; y += 11) pts.push({ x: cx + rx, y: y, t: 90 });

    var out = '';
    out += '<ellipse cx="195" cy="600" rx="300" ry="70" fill="rgba(110,123,79,.10)"/>';
    out += '<rect x="-20" y="500" width="120" height="80" rx="34" fill="rgba(110,123,79,.16)"/>';
    out += '<rect x="290" y="500" width="120" height="80" rx="34" fill="rgba(110,123,79,.16)"/>';
    out += '<path d="M' + (cx - rx) + ' ' + legBottom + ' V ' + cy + ' A ' + rx + ' ' + ry + ' 0 0 1 ' + (cx + rx) + ' ' + cy + ' V ' + legBottom + '" fill="none" stroke="' + OLIVE3 + '" stroke-width="1.6"/>';
    pts.forEach(function(p, i){
      var side = i % 2 ? 1 : -1;
      var nx = Math.cos((p.t + 90) * Math.PI / 180), ny = Math.sin((p.t + 90) * Math.PI / 180);
      var off = 7 + rnd() * 5;
      var lx = p.x + nx * off * side, ly = p.y + ny * off * side;
      var ang = p.t + side * (38 + rnd() * 26);
      var fill = i % 3 === 0 ? OLIVE2 : (i % 3 === 1 ? OLIVE : OLIVE3);
      out += leaf(lx, ly, ang, 11 + rnd() * 5, 3.6 + rnd() * 1.4, fill);
      if (rnd() < .28) out += leaf(p.x - nx * (4 + rnd() * 4) * side, p.y - ny * (4 + rnd() * 4) * side, p.t - side * (30 + rnd() * 20), 9 + rnd() * 4, 3 + rnd(), fill);
      if (i % 9 === 4) out += lemon(p.x + nx * 15 * side, p.y + ny * 15 * side, p.t + side * 20, 7 + rnd() * 2);
    });
    svg.innerHTML = out;
  }

  /* ---------- Small branch dividers ---------- */
  function branch(){
    var rnd = rng(1406);
    var w = 220, h = 40, mid = 20;
    var s = '<svg viewBox="0 0 ' + w + ' ' + h + '" aria-hidden="true">';
    s += '<path d="M6 ' + mid + ' Q ' + (w / 2) + ' ' + (mid - 5) + ' ' + (w - 6) + ' ' + mid + '" fill="none" stroke="' + OLIVE3 + '" stroke-width="1.1"/>';
    for (var x = 18; x < w - 12; x += 15){
      var y = mid - 5 * Math.sin(Math.PI * x / w);
      var up = Math.round(x / 15) % 2 === 0;
      var fill = up ? OLIVE : OLIVE2;
      s += leaf(x, y + (up ? -5 : 5), up ? -34 : 34, 7.5 + rnd() * 2, 2.6, fill);
    }
    s += lemon(w / 2, mid + 1, 12, 5.5);
    s += '</svg>';
    return s;
  }
  $$('[data-branch]').forEach(function(d){ d.innerHTML = branch(); });
  drawArch();

  /* ---------- Envelope intro ---------- */
  var intro = $('#intro'), env = $('#env'), openBtn = $('#openBtn');
  document.body.classList.add('locked');
  var opened = false;
  function openInvite(){
    if (opened) return; opened = true;
    if (reduce){ intro.hidden = true; document.body.classList.remove('locked'); return; }
    env.classList.add('open');
    $('#tapLabel').style.opacity = '0';
    setTimeout(function(){ intro.classList.add('fade'); }, 1500);
    setTimeout(function(){ intro.hidden = true; document.body.classList.remove('locked'); }, 2250);
  }
  openBtn.addEventListener('click', openInvite);
  $('#introCol').addEventListener('click', function(e){ if (e.target !== openBtn && !openBtn.contains(e.target)) openInvite(); });

  /* ---------- Links built from settings ---------- */
  var q = encodeURIComponent(CONFIG.venueName + ', ' + CONFIG.venueAddress);
  $('#mapsLink').href = 'https://www.google.com/maps/search/?api=1&query=' + q;
  var start = new Date(CONFIG.weddingDate);
  function gcalStamp(d){ return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z'); }
  $('#calLink').href = 'https://calendar.google.com/calendar/render?action=TEMPLATE' +
    '&text=' + encodeURIComponent(CONFIG.coupleShort + "'s wedding") +
    '&dates=' + gcalStamp(start) + '/' + CONFIG.weddingEndUTC +
    '&details=' + encodeURIComponent('Ceremony at 4:30 PM on the sea terrace, reception and dinner to follow. Dress code: garden formal.') +
    '&location=' + q;

  /* ---------- Countdown ---------- */
  var cd = { d: $('#cd-d'), h: $('#cd-h'), m: $('#cd-m') };
  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function tick(){
    var diff = start - Date.now();
    if (diff <= 0){
      cd.d.textContent = '0'; cd.h.textContent = '00'; cd.m.textContent = '00';
      $('#cdLabel').textContent = "Today's the day";
      return;
    }
    var sec = Math.floor(diff / 1000);
    cd.d.textContent = Math.floor(sec / 86400);
    cd.h.textContent = pad(Math.floor(sec % 86400 / 3600));
    cd.m.textContent = pad(Math.floor(sec % 3600 / 60));
  }
  tick(); setInterval(tick, 1000);

  /* ---------- Scratch to reveal ---------- */
  (function(){
    var wrap = $('#revealWrap'), canvas = $('#scratch'), hint = $('#revealHint');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var W, H, scratching = false, moves = 0, done = false;
    function paint(){
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = wrap.clientWidth; H = wrap.clientHeight;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.globalCompositeOperation = 'source-over';
      var g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, '#D9B27C'); g.addColorStop(.45, '#C99A5E'); g.addColorStop(.55, '#E4C48B'); g.addColorStop(1, '#B98A4E');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      var rnd = rng(42);
      ctx.globalAlpha = .12;
      for (var i = 0; i < 380; i++){
        ctx.fillStyle = rnd() > .5 ? '#FFF6E3' : '#7A5426';
        ctx.fillRect(rnd() * W, rnd() * H, 1 + rnd() * 30, 1);
      }
      ctx.globalAlpha = 1;
      ctx.fillStyle = 'rgba(60,40,18,.75)';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.font = '700 44px Corinthia, Italianno, cursive';
      ctx.fillText('Scratch here', W / 2, H / 2 - 8);
      ctx.font = '400 10px Jost, sans-serif';
      ctx.fillStyle = 'rgba(60,40,18,.6)';
      ctx.fillText('R U B   T O   R E V E A L', W / 2, H / 2 + 26);
      ctx.globalCompositeOperation = 'destination-out';
    }
    function pos(e){ var r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
    function erase(p){ ctx.beginPath(); ctx.arc(p.x, p.y, 26, 0, Math.PI * 2); ctx.fill(); }
    function cleared(){
      var data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      var clear = 0, total = 0;
      for (var i = 3; i < data.length; i += 4 * 7){ total++; if (data[i] < 40) clear++; }
      return clear / total;
    }
    function finish(){ if (done) return; done = true; canvas.classList.add('done'); hint.textContent = 'Where it all began'; }
    canvas.addEventListener('pointerdown', function(e){ scratching = true; try { canvas.setPointerCapture(e.pointerId); } catch (err){} erase(pos(e)); });
    canvas.addEventListener('pointermove', function(e){
      if (!scratching) return; erase(pos(e));
      if (++moves % 12 === 0 && cleared() > .5) finish();
    });
    function stop(){ if (scratching && cleared() > .5) finish(); scratching = false; }
    canvas.addEventListener('pointerup', stop); canvas.addEventListener('pointercancel', stop);
    canvas.addEventListener('dblclick', finish);
    paint();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ if (!done && moves === 0) paint(); });
    var rt; window.addEventListener('resize', function(){ clearTimeout(rt); rt = setTimeout(function(){ if (!done && moves === 0) paint(); }, 150); });
  })();

  /* ---------- RSVP ---------- */
  (function(){
    var form = $('#rsvpForm'), done = $('#rsvpDone'), saved = $('#rsvpSaved');
    var guestsNum = $('#guestsNum'), guests = 1;
    $('#minus').addEventListener('click', function(){ guests = Math.max(1, guests - 1); guestsNum.textContent = guests; });
    $('#plus').addEventListener('click', function(){ guests = Math.min(6, guests + 1); guestsNum.textContent = guests; });

    function attending(){ var r = form.querySelector('input[name=attending]:checked'); return r ? r.value : ''; }
    function toggleGuestFields(){
      var no = attending() === 'no';
      ['#guestsField', '#dietField', '#songField'].forEach(function(id){ $(id).hidden = no; });
    }
    $$('input[name=attending]', form).forEach(function(r){ r.addEventListener('change', function(){ toggleGuestFields(); $('#attErr').hidden = true; }); });
    $('#name').addEventListener('input', function(){ $('#nameErr').hidden = true; });

    var KEY = 'rsvp-clara-julian';
    function load(){ try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e){ return null; } }
    function store(v){ try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e){} }

    function summarize(v){
      var lines = ['RSVP · ' + CONFIG.coupleShort + ' · 19 June 2027', 'Name: ' + v.name, 'Attending: ' + (v.attending === 'yes' ? 'Joyfully accepts' : 'Regretfully declines')];
      if (v.attending === 'yes'){
        lines.push('Guests: ' + v.guests);
        lines.push('Dietary: ' + (v.diet.length ? v.diet.join(', ') : 'None'));
        if (v.song) lines.push('Song request: ' + v.song);
      }
      if (v.message) lines.push('Message: ' + v.message);
      return lines.join('\n');
    }

    function showDone(v){
      var text = summarize(v);
      var first = v.name.split(' ')[0];
      form.hidden = true; saved.hidden = true; done.hidden = false;
      $('#doneTitle').textContent = v.attending === 'yes' ? 'Grazie' : "We'll miss you";
      $('#doneText').textContent = v.attending === 'yes'
        ? "We can't wait to see you in Ravello, " + first + '.'
        : 'Thank you for letting us know, ' + first + ". We'll raise a glass to you.";
      $('#summary').textContent = text;
      var row = $('#sendRow'); row.innerHTML = '';
      var enc = encodeURIComponent(text);
      if (CONFIG.rsvpWhatsApp){
        var wa = document.createElement('a'); wa.className = 'btn btn--primary'; wa.target = '_blank'; wa.rel = 'noopener';
        wa.href = 'https://wa.me/' + CONFIG.rsvpWhatsApp + '?text=' + enc; wa.textContent = 'Send via WhatsApp'; row.appendChild(wa);
      }
      if (CONFIG.rsvpEmail){
        var em = document.createElement('a'); em.className = 'btn';
        em.href = 'mailto:' + CONFIG.rsvpEmail + '?subject=' + encodeURIComponent('RSVP – ' + v.name) + '&body=' + enc; em.textContent = 'Send by email'; row.appendChild(em);
      }
      var copy = document.createElement('button'); copy.type = 'button'; copy.className = 'btn btn--ghost'; copy.textContent = 'Copy reply';
      copy.addEventListener('click', function(){
        var ok = function(){ copy.textContent = 'Copied'; setTimeout(function(){ copy.textContent = 'Copy reply'; }, 1800); };
        var fallback = function(){
          var r = document.createRange(); r.selectNodeContents($('#summary'));
          var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
          try { document.execCommand('copy'); ok(); } catch (e){}
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(ok, fallback);
        else fallback();
      });
      row.appendChild(copy);
      $('#doneNote').textContent = (CONFIG.rsvpWhatsApp || CONFIG.rsvpEmail)
        ? 'Tap a button above so your reply reaches us. It is also saved on this device.'
        : 'Your reply is saved on this device. Copy it and send it to us any way you like.';
      done.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }

    form.addEventListener('submit', function(e){
      e.preventDefault();
      var name = $('#name').value.trim();
      var att = attending();
      var ok = true;
      if (!name){ $('#nameErr').hidden = false; ok = false; }
      if (!att){ $('#attErr').hidden = false; ok = false; }
      if (!ok) return;
      var v = {
        name: name, attending: att, guests: att === 'yes' ? guests : 0,
        diet: $$('input[name=diet]:checked', form).map(function(c){ return c.value; }),
        song: $('#song').value.trim(), message: $('#message').value.trim(), at: new Date().toISOString()
      };
      store(v); showDone(v);
    });

    $('#editReply').addEventListener('click', function(){
      var v = load(); saved.hidden = true; form.hidden = false;
      if (v){
        $('#name').value = v.name || '';
        var r = form.querySelector('input[name=attending][value="' + v.attending + '"]'); if (r) r.checked = true;
        guests = Math.max(1, v.guests || 1); guestsNum.textContent = guests;
        $$('input[name=diet]', form).forEach(function(c){ c.checked = (v.diet || []).indexOf(c.value) > -1; });
        $('#song').value = v.song || ''; $('#message').value = v.message || '';
        toggleGuestFields();
      }
    });

    var prev = load();
    if (prev && prev.name){
      form.hidden = true; saved.hidden = false;
      $('#savedText').textContent = (prev.attending === 'yes' ? "You replied that you'll be joining us" : "You replied that you can't make it") + ', ' + prev.name.split(' ')[0] + '. Reply again if anything changes.';
    }
  })();

  /* ---------- Music box (Web Audio, no files) ---------- */
  (function(){
    var btn = $('#musicBtn'), label = $('#musicLabel');
    var ac, master, timer, on = false, step = 0, nextTime = 0;
    var F4 = 349.23, A4 = 440, Bb4 = 466.16, C5 = 523.25, D5 = 587.33, E5 = 659.25, F5 = 698.46, G5 = 783.99, A5 = 880, C6 = 1046.5;
    var melody = [F5, 0, A5, 0, C6, 0, A5, 0, G5, 0, F5, 0, E5, 0, F5, 0,   D5, 0, F5, 0, A5, 0, F5, 0, E5, 0, D5, 0, C5, 0, D5, 0,
                  Bb4, 0, D5, 0, F5, 0, D5, 0, C5, 0, Bb4, 0, A4, 0, Bb4, 0,   C5, 0, E5, 0, G5, 0, E5, 0, F5, 0, 0, 0, 0, 0, 0, 0];
    var bass   = [F4, 0, 0, 0, 0, 0, 0, 0, C5, 0, 0, 0, 0, 0, 0, 0,   D5 / 2, 0, 0, 0, 0, 0, 0, 0, A4, 0, 0, 0, 0, 0, 0, 0,
                  Bb4, 0, 0, 0, 0, 0, 0, 0, F4, 0, 0, 0, 0, 0, 0, 0,   C5, 0, 0, 0, 0, 0, 0, 0, F4, 0, 0, 0, 0, 0, 0, 0];
    var STEP = 0.21;
    function pluck(f, t, vol){
      var o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), g2 = ac.createGain();
      o.type = 'sine'; o.frequency.value = f; o2.type = 'triangle'; o2.frequency.value = f * 2; g2.gain.value = .18;
      g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + .008); g.gain.exponentialRampToValueAtTime(.0001, t + 1.9);
      o.connect(g); o2.connect(g2); g2.connect(g); g.connect(master);
      o.start(t); o2.start(t); o.stop(t + 2); o2.stop(t + 2);
    }
    function schedule(){
      while (nextTime < ac.currentTime + .4){
        var i = step % melody.length;
        if (melody[i]) pluck(melody[i], nextTime, .16);
        if (bass[i]) pluck(bass[i], nextTime, .10);
        nextTime += STEP; step++;
      }
    }
    function start(){
      if (!ac){
        var AC = window.AudioContext || window.webkitAudioContext; if (!AC){ btn.hidden = true; return; }
        ac = new AC();
        master = ac.createGain(); master.gain.value = 0;
        var lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 3200;
        var delay = ac.createDelay(1.5); delay.delayTime.value = .31;
        var fb = ac.createGain(); fb.gain.value = .32;
        var wet = ac.createGain(); wet.gain.value = .35;
        master.connect(lp); lp.connect(ac.destination);
        lp.connect(delay); delay.connect(fb); fb.connect(delay); delay.connect(wet); wet.connect(ac.destination);
      }
      if (ac.state === 'suspended') ac.resume();
      master.gain.cancelScheduledValues(ac.currentTime); master.gain.setValueAtTime(master.gain.value, ac.currentTime); master.gain.linearRampToValueAtTime(1, ac.currentTime + 1.2);
      nextTime = Math.max(nextTime, ac.currentTime + .05);
      schedule(); timer = setInterval(schedule, 120);
      on = true; btn.classList.add('on'); btn.setAttribute('aria-pressed', 'true'); btn.setAttribute('aria-label', 'Pause music'); label.textContent = 'Playing';
    }
    function stop(){
      clearInterval(timer);
      if (ac){ master.gain.cancelScheduledValues(ac.currentTime); master.gain.setValueAtTime(master.gain.value, ac.currentTime); master.gain.linearRampToValueAtTime(0, ac.currentTime + .6); }
      on = false; btn.classList.remove('on'); btn.setAttribute('aria-pressed', 'false'); btn.setAttribute('aria-label', 'Play music'); label.textContent = 'Music';
    }
    btn.addEventListener('click', function(){ if (on) stop(); else start(); });
    document.addEventListener('visibilitychange', function(){ if (document.hidden && on) stop(); });
  })();
})();
</script>
